NODE_ENV=development
HOST=127.0.0.1
PORT=3003
DATABASE_URL=postgresql://hireos@127.0.0.1:55432/hireos_identity

# Workspace every subsystem already stores on its records.
DEFAULT_WORKSPACE_ID=local-screening-workspace
WORKSPACE_NAME=HireOS
# Comma-separated; ensured as active admins on every start.
BOOTSTRAP_ADMIN_EMAILS=sujunjie427@gmail.com

# HMAC key for stored sign-in codes (required in production).
LOGIN_CODE_SECRET=
# Shared secret the other backends send to /api/internal/sessions/introspect.
INTERNAL_TOKEN=local-dev-internal-token

# Deploy path prefix in front of /screening/, /jd/ … ('' locally, /hireos on the server).
APP_BASE_PATH=
PUBLIC_URL=http://localhost:8080
# Proxies in front that append X-Forwarded-For (server nginx + gateway nginx).
TRUSTED_PROXY_HOPS=0
COOKIE_PATH=/
COOKIE_SECURE=false
# Comma-separated origins allowed to send state-changing requests; empty = no check.
ALLOWED_ORIGINS=

# Front ends redirect signed-out visitors to sign-in only when true (pair with AUTH_MODE=session on the backends).
LOGIN_REQUIRED=false
# One-click demo accounts on the sign-in page (ignored when NODE_ENV=production).
DEV_LOGIN_ENABLED=true

# console = print mails to the log (local); smtp = send (Gmail app password).
MAIL_TRANSPORT=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
