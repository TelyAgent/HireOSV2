NODE_ENV=production
HOST=0.0.0.0
PORT=3003
DATABASE_URL=postgresql://hireos:__FILL_IN__@postgres:5432/hireos_identity

DEFAULT_WORKSPACE_ID=local-screening-workspace
WORKSPACE_NAME=HireOS
BOOTSTRAP_ADMIN_EMAILS=sujunjie427@gmail.com

# openssl rand -hex 32
LOGIN_CODE_SECRET=__FILL_IN__
# openssl rand -hex 32 — the same value goes into every backend's IDENTITY_INTERNAL_TOKEN
INTERNAL_TOKEN=__FILL_IN__

APP_BASE_PATH=/hireos
PUBLIC_URL=https://hireos.aipollo.me/hireos
# Proxies in front that append X-Forwarded-For (server nginx + gateway nginx).
TRUSTED_PROXY_HOPS=2
COOKIE_PATH=/hireos/
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://hireos.aipollo.me

LOGIN_REQUIRED=false
DEV_LOGIN_ENABLED=false

MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=__FILL_IN__
# Gmail app password (Google account → Security → App passwords), not the account password
SMTP_PASS=__FILL_IN__
MAIL_FROM=HireOS <__SAME_AS_SMTP_USER__>
