NODE_ENV=development
HOST=127.0.0.1
PORT=3008
CORS_ORIGIN=http://localhost:5178
DATABASE_URL=postgresql://hireos@127.0.0.1:55432/hireos_written
DEV_AUTH_ENABLED=true
DEV_WORKSPACE_ID=local-screening-workspace
DEV_ACTOR_ID=local-written-user
HIREOS_AI_API_KEY=
HIREOS_AI_BASE_URL=
HIREOS_AI_TIMEOUT_SECONDS=60
HIREOS_AI_MODEL=
PUBLIC_APP_BASE_URL=http://127.0.0.1:5178/written/
INTERVIEW_BASE_URL=http://127.0.0.1:3001/api

# Shared sign-in (hireos-identity). dev = no session → fixed local dev identity (as before);
# session = a signed-in hireos_sid cookie or a service token is required.
AUTH_MODE=dev
IDENTITY_INTERNAL_URL=http://127.0.0.1:3003/api
IDENTITY_INTERNAL_TOKEN=local-dev-internal-token
# Same value in every backend: authenticates backend-to-backend calls.
SERVICE_TOKEN=local-dev-service-token
# Comma-separated; state-changing browser requests from other origins are refused. Empty = no check.
ALLOWED_ORIGINS=
