generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobDraft {
  id                 String   @id @default(uuid())
  workspaceId        String
  jobId              String
  coreRoleVersionId  String
  revision           Int      @default(1)
  status             String   @default("draft")
  roleSummary        String?
  responsibilities   Json
  requirements       Json
  dimensions         Json
  hiringContext      Json?
  successCriteria    Json?
  internalCompensation Json?
  publicCompensation Json?
  sourceRefs         Json
  origin             String   @default("jd_module")
  mappingStatus      String   @default("consistent")
  contentHash        String
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([workspaceId, jobId, revision])
  @@index([workspaceId, jobId, status])
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  workspaceId   String
  operation     String
  key           String
  requestHash   String
  responseBody  Json
  createdAt     DateTime @default(now())

  @@unique([workspaceId, operation, key])
}

model CopilotConversation {
  id            String   @id @default(uuid())
  workspaceId   String
  actorId       String
  jobId         String?
  phase         String   @default("intake")
  fields        Json     @default("{}")
  missingFields Json     @default("[]")
  /// Per-field source / revision / confirmation status of the draft (#68), see src/copilot/field-meta.ts.
  fieldMeta     Json     @default("{}")
  stateRevision Int      @default(0)
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages CopilotMessage[]
  runs     AiRun[]

  @@index([workspaceId, actorId, updatedAt])
}

model CopilotMessage {
  id             String   @id @default(uuid())
  conversationId String
  sequence       Int
  role           String
  text           String?
  attachments    Json?
  idempotencyKey String?
  createdAt      DateTime @default(now())

  conversation CopilotConversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, sequence])
}

model AiRun {
  id             String   @id @default(uuid())
  workspaceId    String
  conversationId String?
  capabilityCode String
  status         String   @default("Queued")
  resultJson     Json?
  failureCode    String?
  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation CopilotConversation? @relation(fields: [conversationId], references: [id])

  @@index([workspaceId, capabilityCode, status])
}

/// The JD document as edited in the job workspace (one per job + audience). Kept separate from
/// JobDraft so saving free-form document edits never collides with a draft's confirm/lock lifecycle.
model JobDocument {
  id          String   @id @default(uuid())
  workspaceId String
  jobId       String
  audience    String
  blocks      Json
  /// Optional job fields that Core Record doesn't hold (department, reports to, hiring reason, …)
  /// plus which of them are shown under the title. Edited together with the document.
  meta        Json?
  revision    Int      @default(1)
  aiAnalysis  Json?
  aiAnalysisRevision Int?
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, jobId, audience])
}

/// A proposed change to one block of a JobDocument — from the Copilot rewrite (author "ai") or typed
/// in Suggesting mode (author "human"). Accepting it is applied to the document client-side; this row
/// only tracks the proposal and its decision so it survives reloads and is visible to the whole team.
model JobDocumentSuggestion {
  id          String    @id @default(uuid())
  workspaceId String
  jobId       String
  audience    String
  anchorBlock String
  status      String    @default("proposed")
  author      String
  initiatedBy String
  createdBy   String
  instruction String    @default("")
  oldText     String
  newText     String
  newItems    Json?
  reason      String    @default("")
  staleReason String?
  supersedes  String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, jobId, audience])
}

/// The job's human-readable JD ID (completeness standard I2): JD-<year>-<4-digit number>, unique per
/// workspace, assigned the first time the job's versions are read.
model JdCode {
  id          String   @id @default(uuid())
  workspaceId String
  jobId       String
  code        String
  year        Int
  seq         Int
  createdAt   DateTime @default(now())

  @@unique([workspaceId, jobId])
  @@unique([workspaceId, code])
}

/// Immutable snapshot written on every Publish: v1, v2, … of the job document.
model JobDocumentVersion {
  id          String   @id @default(uuid())
  workspaceId String
  jobId       String
  versionNo   Int
  /// e.g. JD-2026-0012@v3
  code        String
  title       String
  blocks      Json
  meta        Json?
  note        String   @default("")
  publishedBy String
  createdBy   String
  publishedAt DateTime @default(now())

  @@unique([workspaceId, jobId, versionNo])
}

/// The raw JD text another subsystem's "new task" entry created a job from (see IntakeService).
/// `contentHash` is over whitespace-normalized text and unique per workspace, so pasting the same
/// JD again resolves to the job it already created instead of a duplicate.
model JdSource {
  id             String   @id @default(uuid())
  workspaceId    String
  jobId          String
  text           String
  contentHash    String
  coreMaterialId String?
  sourceService  String
  createdBy      String
  createdAt      DateTime @default(now())
  // The draft intake wrote from the AI's reading of the text, with the content hash it was written
  // with. Drafts are edited in place, so "still intake's draft" means same id AND same hash AND not
  // yet confirmed; while that holds the raw text is the authoritative JD (see isIntakeOwned).
  draftId     String?
  draftHash   String?

  @@unique([workspaceId, contentHash])
  @@index([workspaceId, jobId])
}
