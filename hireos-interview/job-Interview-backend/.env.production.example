PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5174
NODE_ENV=development
DEV_AUTH_ENABLED=true
DATABASE_URL=postgresql://hireos:__FILL_IN__@postgres:5432/hireos_interview
STORAGE_DIR=.local/materials
HIREOS_AI_API_KEY=
HIREOS_AI_BASE_URL=https://api.openai.com/v1
HIREOS_AI_TIMEOUT_SECONDS=60
HIREOS_AI_SEARCH_TOTAL_TIMEOUT_SECONDS=720
HIREOS_AI_MIN_CONFIDENCE=0.85
HIREOS_AI_MODEL=gpt-5.6-luna

# Local-only Zoom PoC. Use a meeting owned by the SDK developer account.
# Host starts the meeting in the Zoom client; HireOS joins as an attendee.
ZOOM_DEV_ENABLED=true
ZOOM_OAUTH_CLIENT_ID=
# Public HTTPS URL that routes to this backend's /api/integrations/zoom/callback
# (a tunnel URL in dev; a real domain once this deployment has one).
ZOOM_OAUTH_REDIRECT_URI=
# Confidential OAuth reuses ZM_RTMS_SECRET below as the main RTMS app secret.
ZOOM_OAUTH_PUBLIC_CLIENT_ID=
ZOOM_OAUTH_CALLBACK_PORT=50590
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=

ZOOM_DEV_MEETING_NUMBER=
ZOOM_DEV_MEETING_PASSWORD=

# Zoom RTMS — fill in the RTMS-enabled app's client id/secret, and a webhook secret token
# (set the same value in the Zoom app's Webhook Secret Token field).
ZM_RTMS_CLIENT=
ZM_RTMS_SECRET=
ZM_RTMS_WEBHOOK_SECRET=
  
