PORT=3001
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
NODE_ENV=development
HOST=127.0.0.1
DEV_AUTH_ENABLED=true
DATABASE_URL=postgresql://hireos@127.0.0.1:55432/hireos_interview
STORAGE_DIR=.local/materials
# A provider supporting chat/completions and strict JSON Schema output.
HIREOS_AI_BASE_URL=https://api.openai.com/v1
HIREOS_AI_API_KEY=
HIREOS_AI_MODEL=gpt-5-mini
HIREOS_AI_TIMEOUT_SECONDS=60
# Reserved for a future search workflow; not used by intake extraction.
HIREOS_AI_SEARCH_TOTAL_TIMEOUT_SECONDS=720
HIREOS_AI_MIN_CONFIDENCE=0.85

# Local-only Zoom PoC. Use a meeting owned by the SDK developer account.
# Host starts the meeting in the Zoom client; HireOS joins as an attendee.
ZOOM_DEV_ENABLED=false
# OAuth authorization uses this client id and its registered redirect URI.
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/integrations/zoom/callback
ZOOM_OAUTH_PUBLIC_CLIENT_ID=
ZOOM_OAUTH_CALLBACK_PORT=50590
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=
ZOOM_DEV_MEETING_NUMBER=
ZOOM_DEV_MEETING_PASSWORD=

# Zoom RTMS (Realtime Media Streams) — live transcript for hosted rounds. Client/secret are
# the RTMS-enabled Zoom app's own credentials (used by the SDK to sign the RTMS media
# handshake); webhook secret validates meeting.rtms_started/stopped deliveries.
ZM_RTMS_CLIENT=
ZM_RTMS_SECRET=
ZM_RTMS_WEBHOOK_SECRET=
