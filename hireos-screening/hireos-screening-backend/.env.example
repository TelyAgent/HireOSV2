NODE_ENV=development
HOST=127.0.0.1
PORT=3002
CORS_ORIGIN=http://localhost:5174
DEV_AUTH_ENABLED=true
DATABASE_URL=postgresql://hireos@127.0.0.1:55433/hireos_screening
STORAGE_DIR=.local/materials

# Core Record compatibility layer. Use mock until the Core Record service is deployed.
CORE_RECORD_MODE=mock
CORE_RECORD_BASE_URL=http://127.0.0.1:3004/api/v1
CORE_RECORD_SERVICE_NAME=screening
JD_BASE_URL=http://127.0.0.1:3005/api

# Optional during Phase 0. Business AI providers are added in later phases.
HIREOS_AI_BASE_URL=
HIREOS_AI_API_KEY=
HIREOS_AI_MODEL=
HIREOS_AI_TIMEOUT_SECONDS=120

# Shared sign-in (hireos-identity). dev = no session → fixed local dev identity (as before);
# session = a signed-in hireos_sid cookie or a service token is required.
AUTH_MODE=dev
IDENTITY_INTERNAL_URL=http://127.0.0.1:3003/api
IDENTITY_INTERNAL_TOKEN=local-dev-internal-token
# Same value in every backend: authenticates backend-to-backend calls.
SERVICE_TOKEN=local-dev-service-token
# Comma-separated; state-changing browser requests from other origins are refused. Empty = no check.
ALLOWED_ORIGINS=
