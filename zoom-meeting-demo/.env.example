# Same underlying Zoom General App as the main project — copy these three values in.
# This file is the only thing that ties this demo to "which Zoom app", nothing else.
ZM_RTMS_CLIENT=
ZM_RTMS_SECRET=
ZM_RTMS_WEBHOOK_SECRET=
ZM_RTMS_LOG_LEVEL=debug

# Must exactly match the redirect URL already registered on the Zoom app (Marketplace ->
# your app -> App Credentials), and must be reachable — this demo answers it itself on
# the same port it listens on.
ZOOM_OAUTH_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/integrations/zoom/callback
